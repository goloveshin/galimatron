aggregate item
{
    versions
    {
        0 = {
            hash = 'ih0'
        };
        1;
    }
}

version 0
{
    label kind = static { part, assembly, spare };
    label need_new_uuid = dynamic { need_gen_uuid };
    code = kind important { "A-1" };
    uuid = need_new_uuid important { "65da7323-a0dc-4351-9465-61dc2abf87e5" };// good: one label and the string on one line
    body = {
        {
            "sku": "widget",
            "alts": [ "w1", "w2" ],
            "pack": { "box": "small", "count": "2" }
        },
        [ "raw", { "k": "v" } ]
    };
}

version 1
{
    delete code;
    uuid = need_new_uuid need_new_name important { "22222222-3333-4444-a555-666666666666" };// good: labels and the string on one line
    note = { "kept" };
}
